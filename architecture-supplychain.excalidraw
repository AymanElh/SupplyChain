      "text": "1. \u26a1 STOCK VERIFICATION #2 (Finished Products Check):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "1. \u26a1 STOCK VERIFICATION #2 (Finished Products Check):",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_9945",
      "type": "text",
      "x": 1670,
      "y": 836,
      "width": 640,
      "height": 18,

      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - IF INSUFFICIENT -> FAILS with BusinessRuleException!",
      "lineHeight": 1.25
    },

      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "1. Order Planning (CHEF_PRODUCTION / PLANIFICATEUR):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "1. Order Planning (CHEF_PRODUCTION / PLANIFICATEUR):",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_9126",
      "type": "text",
      "x": 880,
      "y": 836,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 523058,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - Creates ProductionOrder with status = DRAFT / PLANNED",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - Creates ProductionOrder with status = DRAFT / PLANNED",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_9296",
      "type": "text",
      "x": 880,
      "y": 858,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 674880,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "2. \u26a1 STOCK VERIFICATION #1 (Raw Materials Check):",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "2. \u26a1 STOCK VERIFICATION #1 (Raw Materials Check):",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_7716",
      "type": "text",
      "x": 880,
      "y": 880,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 921916,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - When starting production: startProduction(orderId)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - When starting production: startProduction(orderId)",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_5040",
      "type": "text",
      "x": 880,
      "y": 902,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 615575,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - Iterates BOM items: reqQty = bom.quantity * order.quantity",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - Iterates BOM items: reqQty = bom.quantity * order.quantity",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_2603",
      "type": "text",
      "x": 880,
      "y": 924,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 708077,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - CALLS SupplyFacade.hasAvailableStock(materialId, reqQty)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - CALLS SupplyFacade.hasAvailableStock(materialId, reqQty)",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_5741",
      "type": "text",
      "x": 880,
      "y": 946,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 721717,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - IF NOT AVAILABLE -> FAILS with BusinessRuleException!",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - IF NOT AVAILABLE -> FAILS with BusinessRuleException!",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_9203",
      "type": "text",
      "x": 880,
      "y": 968,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 209598,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "3. \u26a1 RAW MATERIALS CONSUMPTION:",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "3. \u26a1 RAW MATERIALS CONSUMPTION:",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_2779",
      "type": "text",
      "x": 880,
      "y": 990,
      "width": 640,
      "height": 18,
      "angle": 0,

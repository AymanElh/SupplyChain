      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - CALLS SupplyFacade.reduceStock(materialId, reqQty)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - CALLS SupplyFacade.reduceStock(materialId, reqQty)",
      "lineHeight": 1.25
    },
    {
      "id": "text_1789644565599_2743",
      "type": "text",
      "x": 880,
      "y": 1012,
      "width": 640,
      "height": 18,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 402485,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - Calculates endDate = startDate + (prodHours / 8)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",

      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - GESTIONNAIRE_COMMERCIAL creates CustomerOrder",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - GESTIONNAIRE_COMMERCIAL creates CustomerOrder",
      "lineHeight": 1.25
    },
    {

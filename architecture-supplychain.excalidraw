      "isDeleted": false,
      "boundElements": null,
      "updated": 1789644565599,
      "link": null,
      "locked": false,
      "text": "   - For each item: CALLS ProductFacade.hasAvailableStock(pId, qty)",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": null,
      "originalText": "   - For each item: CALLS ProductFacade.hasAvailableStock(pId, qty)",
      "lineHeight": 1.25
    },
    {

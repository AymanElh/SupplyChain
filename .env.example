# Copy to .env.prod on the VM. Never commit .env.prod.
POSTGRES_USER=supply_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=supply_db

KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_REALM=supplychain

JWT_SECRET=replace-with-a-long-random-secret
KEYCLOAK_ISSUER_URI=https://app.example.com/auth/realms/supplychain
